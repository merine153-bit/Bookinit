# Eatit — إعدادات البيئة
# انسخ هذا الملف إلى .env.local ثم املأ القيم.
#
# عند ترك هذه القيم فارغة يعمل التطبيق في "وضع العرض التجريبي"
# مستخدماً بيانات تجريبية محلية بالكامل (بدون قاعدة بيانات).

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# المفتاح العلني (publishable) — آمن للاستخدام في المتصفح.
# الصيغة الجديدة: sb_publishable_...  |  الصيغة القديمة: anon JWT
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# فعّل هذا فقط بعد تفعيل مزوّد Google في Supabase → Authentication → Providers،
# وإلا فلن يظهر زر "المتابعة عبر Google" (تفادياً لزر لا يعمل).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# تنبيه: لا تضع المفتاح السري (sb_secret_...) هنا أبداً.
# التطبيق لا يحتاجه؛ كل الوصول يمر عبر سياسات RLS.
